# InternX AI - Frontend Environment Template (For Render / Vercel / Netlify Production Deployment)

# Production Backend API Endpoint URL (Replace with your active Render Backend API URL)
VITE_API_BASE_URL="https://internx-api.onrender.com/api/v1"
VITE_BACKEND_URL="https://internx-api.onrender.com"
VITE_FRONTEND_URL="https://internx-ai.vercel.app"

# Application Metadata
VITE_APP_TITLE="InternX AI - Placement & Internship Portal"
VITE_ENVIRONMENT="production"

# Cloud Storage Configuration Indicator
VITE_CLOUDINARY_CLOUD_NAME="ddpcxdd1a"
VITE_MAX_UPLOAD_SIZE_MB=10

# Feature Toggles
VITE_ENABLE_EMAIL_ALERTS=true
VITE_ENABLE_OTP_VERIFICATION=true
VITE_ENABLE_AI_FEATURES=true
