# InternX AI - Backend Environment Template (For Render / Railway / Docker Deployment)

PROJECT_NAME="InternX AI"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
FRONTEND_URL="https://internx-ai.vercel.app"
BACKEND_URL="https://internx-api.onrender.com"

SECRET_KEY="your-production-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial System Administrator Credentials Placeholder (Set private credentials in server ENV)
FIRST_SUPERUSER="admin@internx.ai"
FIRST_SUPERUSER_PASSWORD="ChangeMeInProduction123!"

# PostgreSQL Production Database URL
DATABASE_URL="postgresql://postgres_user:strong_password@ep-production.postgresql.provider.com:5432/internx_db"

# Gemini AI API Key
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"

# Background Email Notifications (SMTP Settings)
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="placement-cell@university.edu"
SMTP_PASSWORD="your-gmail-app-password"
EMAILS_FROM_EMAIL="placement-cell@university.edu"
EMAILS_FROM_NAME="InternX AI Placement Officer"

# CORS Configuration
BACKEND_CORS_ORIGINS=["https://internx-ai.vercel.app"]
